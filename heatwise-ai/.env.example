# Copy to .env and adjust. Never commit .env or AWS credentials.
# AWS credentials come from your normal AWS profile / SSO / role, not this file.

AWS_REGION=us-east-1
# Amazon Nova via a system-defined cross-region inference profile.
BEDROCK_MODEL_ID=us.amazon.nova-2-lite-v1:0

# open_meteo = live data (no API key needed). demo = labelled fixture data only.
WEATHER_PROVIDER=open_meteo
HTTP_TIMEOUT_SECONDS=10
WEATHER_STALE_AFTER_MINUTES=90

# Agent execution limits
AGENT_MAX_TURNS=8
AGENT_MAX_TOOL_CALLS=6

# Milestone 2 (defaults shown; uncomment to change)
# Vulnerability indicators needed to raise the risk category one step (project heuristic).
# RISK_VULNERABILITY_MIN_INDICATORS=2
# PLANNER_MAX_TOOL_CALLS=14
# PLAN_MAX_GENERAL_ADVICE=3
# Optional non-blocking LLM review in the Safety Agent (pass/fail stays deterministic).
# SAFETY_LLM_REVIEW=true
# COORDINATOR_MAX_TURNS=16
# COORDINATOR_MAX_TOOL_CALLS=10

# Milestone 3 API (defaults shown; uncomment to change)
# bedrock = real agents. offline = scripted agents for demos only (use with WEATHER_PROVIDER=demo).
# AGENT_MODE=bedrock
# ASSESSMENT_STORE_DIR=.data/assessments
# API_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# API_JOB_WORKERS=2
# API_MAX_PENDING_JOBS=20

# Milestone 4 persistence and deployment (defaults shown; uncomment to change)
# json = local files in ASSESSMENT_STORE_DIR. dynamodb = ASSESSMENTS_TABLE_NAME (required then).
# ASSESSMENT_STORE=json
# ASSESSMENTS_TABLE_NAME=
# memory = in-process jobs. dynamodb = JOBS_TABLE_NAME (required then).
# JOB_STORE=memory
# JOBS_TABLE_NAME=
# thread = local worker threads. lambda = async invoke of WORKER_FUNCTION_NAME.
# JOB_DISPATCH=thread
# WORKER_FUNCTION_NAME=
# JOB_TTL_DAYS=7
# JOB_STALE_AFTER_SECONDS=420
# Coordinator conversation storage (Strands session manager): file, s3 or none.
# SESSION_STORAGE=file
# SESSION_DIR=.data/sessions
# SESSION_BUCKET=
# SESSION_PREFIX=sessions

LOG_LEVEL=INFO
